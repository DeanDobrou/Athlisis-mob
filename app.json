{
  "expo": {
    "name": "Athlisis",
    "slug": "ATLS",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "athlisis",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "gr.athlisis.app",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "gr.athlisis.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ef911840-2110-434e-b3cb-ecf87864f378"
      }
    },
    "owner": "dobroudev",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/ef911840-2110-434e-b3cb-ecf87864f378"
    }
  }
}
